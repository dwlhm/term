// Production Metal image shader. Instance attributes use buffer(0); uniforms use buffer(1).
#include <metal_stdlib>
using namespace metal;

struct ImageUniforms {
    float2 screen_size;
    float2 cell_size;
};

struct ImageVertexIn {
    float2 position [[attribute(0)]];
    float2 image_size [[attribute(1)]];
    float4 uv_rect [[attribute(2)]];
    float4 tint [[attribute(3)]];
};

struct ImageVertexOut {
    float4 clip_position [[position]];
    float2 tex_coord;
    float4 tint;
};

vertex ImageVertexOut vs_main(
    ImageVertexIn in [[stage_in]],
    constant ImageUniforms &uniforms [[buffer(1)]],
    uint vid [[vertex_id]])
{
    float2 corners[6] = {
        float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
        float2(0.0, 1.0), float2(1.0, 0.0), float2(1.0, 1.0)
    };
    float2 corner = corners[vid % 6];
    float2 world_pos = in.position + corner * in.image_size;
    float clip_x = (world_pos.x / uniforms.screen_size.x) * 2.0 - 1.0;
    float clip_y = 1.0 - (world_pos.y / uniforms.screen_size.y) * 2.0;
    ImageVertexOut out;
    out.clip_position = float4(clip_x, clip_y, 0.0, 1.0);
    out.tex_coord = mix(in.uv_rect.xy, in.uv_rect.zw, corner);
    out.tint = in.tint;
    return out;
}

fragment float4 fs_main(
    ImageVertexOut in [[stage_in]],
    texture2d<float> image_texture [[texture(1)]],
    sampler image_sampler [[sampler(2)]])
{
    constexpr sampler sample_state(address::clamp_to_edge, filter::nearest);
    float4 sampled = image_texture.sample(sample_state, in.tex_coord);
    if (sampled.a < 0.01) { discard_fragment(); }
    return float4(sampled.rgb * in.tint.rgb, sampled.a * in.tint.a);
}
