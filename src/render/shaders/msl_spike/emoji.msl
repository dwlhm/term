#include <metal_stdlib>
using namespace metal;

struct BenchUniforms {
    float2 screen_size;
    float2 cell_size;
};

struct BenchEmojiVertexIn {
    float2 position [[attribute(0)]];
    float2 cell_size [[attribute(1)]];
    float4 uv_rect   [[attribute(2)]];
    float4 fg_color  [[attribute(3)]];
};

struct BenchEmojiVertexOut {
    float4 clip_position [[position]];
    float2 tex_coord;
};

vertex BenchEmojiVertexOut vs_main(
    BenchEmojiVertexIn   in       [[stage_in]],
    constant BenchUniforms &uniforms [[buffer(1)]],
    uint                 vid      [[vertex_id]])
{
    float2 corners[6] = {
        float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
        float2(0.0, 1.0), float2(1.0, 0.0), float2(1.0, 1.0)
    };
    float2 corner = corners[vid % 6];
    float2 world_pos = in.position + corner * in.cell_size;
    float clip_x = (world_pos.x / uniforms.screen_size.x) * 2.0 - 1.0;
    float clip_y = 1.0 - (world_pos.y / uniforms.screen_size.y) * 2.0;
    BenchEmojiVertexOut out;
    out.clip_position = float4(clip_x, clip_y, 0.0, 1.0);
    out.tex_coord = mix(in.uv_rect.xy, in.uv_rect.zw, corner);
    return out;
}

fragment float4 fs_main(
    BenchEmojiVertexOut  in            [[stage_in]],
    texture2d<float>     emoji_texture [[texture(1)]],
    sampler              emoji_sampler [[sampler(2)]])
{
    constexpr sampler s(address::clamp_to_edge, filter::linear);
    float4 color = emoji_texture.sample(s, in.tex_coord);
    if (color.a < 0.01) {
        discard_fragment();
    }
    return color;
}
