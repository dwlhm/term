// Production Metal tile compute shader: renders dirty tiles into the framebuffer texture.
// Entry point: cs_main with [[threads_per_threadgroup(8, 8, 1)]].

#include <metal_stdlib>
using namespace metal;

struct Tile_Params {
    float screen_w;
    float screen_h;
    uint  cols;
    uint  rows;
    float cell_w;
    float cell_h;
    float pad_x;
    float pad_y;
    uint  tile_w;
    uint  tile_h;
    uint  tiles_x;
    uint  tiles_y;
    uint  atlas_w;
    uint  atlas_h;
    float bg_opacity;
    float cell_opacity;
};

constant uint CELL_FLAG_SELECTED = 2u;
constant uint CELL_FLAG_DIRECT_COLOR = 8u;
constant uint LUT_SELECTION_WORD = 1024u;
constant uint COLOR_WORDS_PER_CELL = 2u;
constant uint ARGB_A_SHIFT = 24u;
constant uint ARGB_R_SHIFT = 16u;
constant uint ARGB_G_SHIFT = 8u;
constant uint ARGB_COMPONENT_MASK = 0xFFu;
constant float OPAQUE_ALPHA = 1.0;

inline float3 r5g6b5_to_rgb(uint packed) {
    float r = float((packed >> 11u) & 0x1Fu) / 31.0;
    float g = float((packed >> 5u) & 0x3Fu) / 63.0;
    float b = float(packed & 0x1Fu) / 31.0;
    return float3(r, g, b);
}

inline float4 unpack_argb(uint c) {
    float a = float((c >> ARGB_A_SHIFT) & ARGB_COMPONENT_MASK) / 255.0;
    float r = float((c >> ARGB_R_SHIFT) & ARGB_COMPONENT_MASK) / 255.0;
    float g = float((c >> ARGB_G_SHIFT) & ARGB_COMPONENT_MASK) / 255.0;
    float b = float(c & ARGB_COMPONENT_MASK) / 255.0;
    return float4(r, g, b, a);
}

inline uint lut_fg(uint s, const device uint* lut) {
    uint w = lut[s >> 1u];
    if ((s & 1u) == 0u) { return w & 0xFFFFu; }
    return (w >> 16u) & 0xFFFFu;
}

inline uint lut_bg(uint s, const device uint* lut) {
    uint w = lut[512u + (s >> 1u)];
    if ((s & 1u) == 0u) { return w & 0xFFFFu; }
    return (w >> 16u) & 0xFFFFu;
}

inline uint lut_selection_fg(const device uint* lut) {
    return lut[LUT_SELECTION_WORD] & 0xFFFFu;
}

inline uint lut_selection_bg(const device uint* lut) {
    return (lut[LUT_SELECTION_WORD] >> 16u) & 0xFFFFu;
}

inline bool cell_is_selected(uint cflags) {
    return (cflags & CELL_FLAG_SELECTED) != 0u;
}

inline float4 cell_background(uint style, uint cflags, float3 bg_rgb, bool has_direct_bg,
                              constant Tile_Params& params, const device uint* lut) {
    bool has_authored_background = cell_is_selected(cflags) ||
        has_direct_bg ||
        lut_bg(style, lut) != lut_bg(0u, lut);
    float3 base_rgb = r5g6b5_to_rgb(lut_bg(0u, lut)) * params.bg_opacity;
    if (has_authored_background) {
        float alpha = params.cell_opacity;
        return float4(bg_rgb * alpha + base_rgb * (1.0 - alpha),
            alpha + params.bg_opacity * (1.0 - alpha));
    }
    return float4(base_rgb, params.bg_opacity);
}

inline float composited_alpha(float background_alpha, float glyph_coverage) {
    return background_alpha + glyph_coverage * (OPAQUE_ALPHA - background_alpha);
}

inline int pinned_slot(uint content) {
    if (content >= 32u && content <= 126u) { return int(content - 32u); }
    if (content >= 0x2500u && content <= 0x257Fu) { return 95 + int(content - 0x2500u); }
    if (content >= 0x2580u && content <= 0x259Fu) { return 223 + int(content - 0x2580u); }
    if (content >= 0xE0B0u && content <= 0xE0BFu) { return 255 + int(content - 0xE0B0u); }
    return -1;
}

inline float4 slot_uv(uint slot, constant Tile_Params& params) {
    float col = float(slot % 16u);
    float row = float(slot / 16u);
    float aw = float(params.atlas_w);
    float ah = float(params.atlas_h);
    return float4(
        col * 16.0 / aw,
        row * 16.0 / ah,
        (col * 16.0 + 16.0) / aw,
        (row * 16.0 + 16.0) / ah);
}

kernel void cs_main(
    uint3 wg [[threadgroup_position_in_grid]],
    uint3 lid [[thread_position_in_threadgroup]],
    constant Tile_Params& params [[buffer(0)]],
    const device uint* tile_list [[buffer(1)]],
    const device uint* cells [[buffer(2)]],
    const device uint* lut [[buffer(3)]],
    texture2d<float> atlas_texture [[texture(4)]],
    sampler atlas_sampler [[sampler(5)]],
    texture2d<float, access::write> framebuffer [[texture(6)]])
{
    uint tile_id = tile_list[wg.x];
    if (tile_id >= params.tiles_x * params.tiles_y) {
        return;
    }
    uint tile_row = tile_id / params.tiles_x;
    uint tile_col = tile_id % params.tiles_x;
    uint orow = tile_row * params.tile_h;
    uint ocol = tile_col * params.tile_w;
    uint cw = min(params.tile_w, params.cols - ocol);
    uint ch = min(params.tile_h, params.rows - orow);
    if (cw == 0u || ch == 0u) {
        return;
    }
    int fb_w = int(params.screen_w);
    int fb_h = int(params.screen_h);

    uint lane = lid.y * 8u + lid.x;
    uint n_cells = cw * ch;
    for (uint i = lane; i < n_cells; i += 64u) {
        uint lr = orow + i / cw;
        uint lc = ocol + i % cw;
        uint ci = lr * params.cols + lc;
        uint lo = cells[ci * 2u];
        uint hi = cells[ci * 2u + 1u];
        uint content = lo & 0x1FFFFFu;
        uint style = (lo >> 21u) & 0x3FFu;
        uint width = ((lo >> 31u) & 1u) | ((hi & 1u) << 1u);
        uint cflags = (hi >> 1u) & 0x7Fu;
        uint slot = (hi >> 8u) & 0x1FFu;

        uint bg_packed = cell_is_selected(cflags) ? lut_selection_bg(lut) : lut_bg(style, lut);
        float3 bg_rgb = r5g6b5_to_rgb(bg_packed);
        float4 background = cell_background(style, cflags, bg_rgb, false, params, lut);
        float background_alpha = background.a;

        int x0 = max(int(params.pad_x + float(lc) * params.cell_w), 0);
        int y0 = max(int(params.pad_y + float(lr) * params.cell_h), 0);
        int x1 = min(x0 + int(params.cell_w), fb_w);
        int y1 = min(y0 + int(params.cell_h), fb_h);

        if (width == 0u) {
            float3 fg_rgb = float3(0.0);
            float4 uvs = float4(0.0);
            bool has_glyph = false;
            float gw = params.cell_w;
            if (lc > 0u) {
                uint ni = lr * params.cols + (lc - 1u);
                uint nlo = cells[ni * 2u];
                uint nhi = cells[ni * 2u + 1u];
                uint nwidth = ((nlo >> 31u) & 1u) | ((nhi & 1u) << 1u);
                if (nwidth == 2u) {
                    uint ncontent = nlo & 0x1FFFFFu;
                    uint nstyle = (nlo >> 21u) & 0x3FFu;
                    uint ncflags = (nhi >> 1u) & 0x7Fu;
                    uint nslot = (nhi >> 8u) & 0x1FFu;
                    if (ncontent != 0x20u && ncontent != 0u) {
                        int su = -1;
                        if (nslot == 0x1FFu) {
                            su = pinned_slot(ncontent);
                        } else if (nslot < 512u) {
                            su = int(nslot);
                        }
                        if (su >= 0) {
                            uint nfg_packed = cell_is_selected(ncflags) ? lut_selection_fg(lut) : lut_fg(nstyle, lut);
                            fg_rgb = r5g6b5_to_rgb(nfg_packed);
                            uvs = slot_uv(uint(su), params);
                            gw = params.cell_w * 2.0;
                            has_glyph = true;
                        }
                    }
                }
            }
            for (int py = y0; py < y1; py++) {
                for (int px = x0; px < x1; px++) {
                    float3 col = background.rgb;
                    float glyph_coverage = 0.0;
                    if (has_glyph) {
                        float fx = (float(px) - (float(x0) - params.cell_w)) / gw;
                        float fy = (float(py) - float(y0)) / params.cell_h;
                        if (fx >= 0.0 && fx < 1.0 && fy >= 0.0 && fy < 1.0) {
                            float u = uvs.x + fx * (uvs.z - uvs.x);
                            float v = uvs.y + fy * (uvs.w - uvs.y);
                            float alpha = atlas_texture.sample(atlas_sampler, float2(u, v)).r;
                            col = mix(col, fg_rgb, alpha);
                            glyph_coverage = alpha;
                        }
                    }
                    framebuffer.write(float4(col, composited_alpha(background_alpha, glyph_coverage)), uint2(px, py));
                }
            }
            continue;
        }

        int su = -1;
        if (slot == 0x1FFu) {
            su = pinned_slot(content);
        } else if (slot < 512u) {
            su = int(slot);
        }
        uint fg_packed = cell_is_selected(cflags) ? lut_selection_fg(lut) : lut_fg(style, lut);
        float3 fg_rgb = r5g6b5_to_rgb(fg_packed);
        bool has_glyph = false;
        float4 uvs = float4(0.0);
        float gw = params.cell_w;
        if (content != 0x20u && content != 0u && su >= 0) {
            uvs = slot_uv(uint(su), params);
            if (width == 2u) {
                gw = params.cell_w * 2.0;
            }
            has_glyph = true;
        }
        for (int py2 = y0; py2 < y1; py2++) {
            for (int px2 = x0; px2 < x1; px2++) {
                float3 col = background.rgb;
                float glyph_coverage = 0.0;
                if (has_glyph) {
                    float fx = (float(px2) - float(x0)) / gw;
                    float fy = (float(py2) - float(y0)) / params.cell_h;
                    if (fx >= 0.0 && fx < 1.0 && fy >= 0.0 && fy < 1.0) {
                        float u = uvs.x + fx * (uvs.z - uvs.x);
                        float v = uvs.y + fy * (uvs.w - uvs.y);
                        float alpha = atlas_texture.sample(atlas_sampler, float2(u, v)).r;
                        col = mix(col, fg_rgb, alpha);
                        glyph_coverage = alpha;
                    }
                }
                framebuffer.write(float4(col, composited_alpha(background_alpha, glyph_coverage)), uint2(px2, py2));
            }
        }
    }
}
