// msl_spike/bg.msl — HAND-DERIVED reference translation of bg.wgsl.
//
// STATUS: BLOCKED-EXPLICIT — no WGSL→MSL translator available in this
// environment (naga: not installed, tint: not installed). This file is a
// minimal hand translation of the background instanced-quad shader for spike
// reference ONLY. It is not translator output and is not compiled by the
// build. The sdl3 spike embeds its own minimal inline MSL quad; see
// src/render/gpu/bench/sdl3_spike.odin.
//
// Source: src/render/shaders/bg.wgsl (vs_main + fs_main).
// Maps: Uniforms(screen_size, cell_size) -> BenchUniforms buffer(0);
//       per-instance position/cell_size/uv_rect/bg_color -> stage-in attrs;
//       clip-space flip (WGSL origin top-left) preserved.

#include <metal_stdlib>
using namespace metal;

struct BenchUniforms {
    float2 screen_size;
    float2 cell_size;
};

struct BenchBgVertexIn {
    float2 position [[attribute(0)]];
    float2 cell_size [[attribute(1)]];
    float4 uv_rect   [[attribute(2)]];
    float4 bg_color  [[attribute(3)]];
};

struct BenchBgVertexOut {
    float4 clip_position [[position]];
    float4 color;
};

vertex BenchBgVertexOut bench_bg_vs(
    BenchBgVertexIn      in       [[stage_in]],
    constant BenchUniforms &uniforms [[buffer(0)]],
    uint                 vid      [[vertex_id]])
{
    // Quad corners match bg.wgsl quad_positions (triangle list, 6 verts).
    float2 corners[6] = {
        float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
        float2(0.0, 1.0), float2(1.0, 0.0), float2(1.0, 1.0)
    };
    float2 corner = corners[vid % 6];
    float2 world_pos = in.position + corner * in.cell_size;
    float clip_x = (world_pos.x / uniforms.screen_size.x) * 2.0 - 1.0;
    float clip_y = 1.0 - (world_pos.y / uniforms.screen_size.y) * 2.0;
    BenchBgVertexOut out;
    out.clip_position = float4(clip_x, clip_y, 0.0, 1.0);
    out.color = in.bg_color;
    return out;
}

fragment float4 bench_bg_fs(BenchBgVertexOut in [[stage_in]]) {
    return in.color;
}
