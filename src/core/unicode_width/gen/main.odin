package unicode_width_gen

// Writes unicode_width/tables.odin from the reference definitions.
// Usage: odin run src/core/unicode_width/gen -- <output path>
// The generator imports unicode_width, so tables.odin must exist; if it is ever
// lost, any stub declaring STAGE1 [0x1100]u8 and STAGE2 [256]u8 bootstraps it.

import "core:fmt"
import "core:os"
import "core:strings"
import ref "../reference"

main :: proc() {
	if len(os.args) != 2 {
		fmt.eprintln("usage: gen <output .odin path>")
		os.exit(2)
	}
	stage1, stage2, ok := ref.build_tables()
	if !ok {
		fmt.eprintln("gen: more than 256 distinct blocks; stage1 no longer fits in u8")
		os.exit(1)
	}

	b := strings.builder_make()
	fmt.sbprintln(&b, "package unicode_width")
	fmt.sbprintln(&b, "")
	fmt.sbprintln(&b, "// Code generated by src/core/unicode_width/gen (make gen-unicode). DO NOT EDIT.")
	fmt.sbprintfln(&b, "// %d blocks of 256 codepoints, %d distinct; %d bytes.", len(stage1), len(stage2) / 256, len(stage1) + len(stage2))
	fmt.sbprintln(&b, "")
	_write_table(&b, "STAGE1", stage1)
	fmt.sbprintln(&b, "")
	_write_table(&b, "STAGE2", stage2)

	if err := os.write_entire_file(os.args[1], transmute([]u8)strings.to_string(b)); err != nil {
		fmt.eprintfln("gen: cannot write %s: %v", os.args[1], err)
		os.exit(1)
	}
}

_write_table :: proc(b: ^strings.Builder, name: string, data: []u8) {
	fmt.sbprintfln(b, "@(rodata)\n%s := [%d]u8{{", name, len(data))
	for start := 0; start < len(data); start += 32 {
		strings.write_byte(b, '\t')
		for v, i in data[start:min(start + 32, len(data))] {
			if i > 0 do strings.write_byte(b, ' ')
			fmt.sbprintf(b, "0x%02x,", v)
		}
		strings.write_byte(b, '\n')
	}
	fmt.sbprintln(b, "}")
}
