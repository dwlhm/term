// Production Metal tile blit shader: samples the compute framebuffer onto the
// surface with a fullscreen triangle. Entry points: vs_main / fs_main.

#include <metal_stdlib>
using namespace metal;

struct Blit_Output {
    float4 clip_position [[position]];
    float2 tex_coord;
};

vertex Blit_Output vs_main(uint vid [[vertex_id]]) {
    float2 positions[3] = {
        float2(-1.0, 1.0),
        float2(3.0, 1.0),
        float2(-1.0, -3.0),
    };
    float2 uvs[3] = {
        float2(0.0, 0.0),
        float2(2.0, 0.0),
        float2(0.0, 2.0),
    };
    Blit_Output out;
    out.clip_position = float4(positions[vid % 3], 0.0, 1.0);
    out.tex_coord = uvs[vid % 3];
    return out;
}

fragment float4 fs_main(
    Blit_Output in [[stage_in]],
    texture2d<float> fb_texture [[texture(0)]],
    sampler          fb_sampler [[sampler(1)]])
{
    return fb_texture.sample(fb_sampler, in.tex_coord);
}
