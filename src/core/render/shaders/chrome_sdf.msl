// Production Metal Shading Language port for Strategy 3: SDF Vector Shader.
// Signed Distance Field evaluation for anti-aliased rounded rectangles and borders.
//
// Box SDF math:
//   d = length(max(abs(p) - b + r, 0.0)) - r with anti-aliasing via smoothstep.
//
// Buffer bindings: Sdf_Params uniform -> buffer(1) to match backend vtable convention.

#include <metal_stdlib>
using namespace metal;

struct Sdf_Params {
    float2 screen_size;
    float2 rect_pos;
    float2 rect_size;
    float  radius;
    float  border_width;
    float4 color;
    float4 border_color;
};

struct Sdf_Vertex_Out {
    float4 position [[position]];
    float2 pixel_coord;
};

vertex Sdf_Vertex_Out chrome_sdf_vs_main(
    uint vid [[vertex_id]],
    constant Sdf_Params &params [[buffer(1)]])
{
    // Procedural quad from 6 vertex IDs with 2px anti-aliasing margin
    float2 corners[6] = {
        float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
        float2(0.0, 1.0), float2(1.0, 0.0), float2(1.0, 1.0)
    };
    float2 corner = corners[vid % 6];
    float2 world_pos = params.rect_pos - 2.0 + corner * (params.rect_size + 4.0);

    float clip_x = (world_pos.x / params.screen_size.x) * 2.0 - 1.0;
    float clip_y = 1.0 - (world_pos.y / params.screen_size.y) * 2.0;

    Sdf_Vertex_Out out;
    out.position = float4(clip_x, clip_y, 0.0, 1.0);
    out.pixel_coord = world_pos;
    return out;
}

fragment float4 chrome_sdf_fs_main(
    Sdf_Vertex_Out in [[stage_in]],
    constant Sdf_Params &params [[buffer(1)]])
{
    float2 center = params.rect_pos + params.rect_size * 0.5;
    float2 b = params.rect_size * 0.5;
    float2 p = in.pixel_coord - center;
    float r = clamp(params.radius, 0.0, min(b.x, b.y));

    // Box SDF formula: d = length(max(abs(p) - b + r, 0.0)) - r
    float2 q = abs(p) - b + float2(r, r);
    float d = length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;

    // Smoothstep anti-aliasing on exterior edge
    float fill_alpha = 1.0 - smoothstep(-0.5, 0.5, d);
    if (fill_alpha <= 0.001) {
        discard_fragment();
    }

    float4 out_col = params.color;

    // Outline border evaluation
    if (params.border_width > 0.0) {
        float bw = params.border_width;
        float border_factor = smoothstep(-bw - 0.5, -bw + 0.5, d);
        out_col = mix(params.color, params.border_color, border_factor);
    }

    out_col.a *= fill_alpha;
    return out_col;
}
